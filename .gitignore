# Purchased source asset. Deliberately not committed: this repo is public, and
# publishing the .blend redistributes the asset rather than using it. The
# derived public/room.glb is committed so the site builds without it.
# Keep the original backed up outside git; see README for where to put it.
*.blend
*.blend1

# Audio, for the same reason as the .blend above and more so: the track in use
# is a commercial release, and this repo is public. Committing it would
# redistribute the recording rather than play it. The player streams
# public/track.mp3 at runtime and degrades to silence when it is absent, so the
# committed site still builds and runs for anyone who clones this.
# Drop your own mixdown in as public/track.mp3 and set TRACK in src/content.ts.
*.mp3

# Cover art, for the same reason as the track. This one is extracted from the
# release's own ID3 tag, so it is exactly as rights-encumbered as the recording.
# The player hides the image when it 404s rather than showing a broken frame.
# If you swap in your own music and own the artwork, delete this line and commit
# it like any other image in public/.
public/cover.webp

node_modules/
dist/
tsconfig.tsbuildinfo
tools/.venv/
tools/shots/
tools/preview/
tools/screens.json
tools/walls.json
*.local
.DS_Store
.env
.env.*
!.env.example
