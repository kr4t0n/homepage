# Argus, the upstream that feeds the pixel board.
#
# Both are read ONLY server-side, by src/server/api.ts. Neither is prefixed
# VITE_, and that is deliberate: Vite inlines VITE_-prefixed variables into the
# client bundle, which would publish the credential to every visitor.
#
# In the cluster these come from a Secret rather than a file.

# Base URL of the Argus deployment. In-cluster service DNS is preferable to the
# public ingress, so the request does not leave the cluster and come back.
ARGUS=https://argus-api.example.com

# Sent as the X-API-Key header. Identifies the account behind /me/pixels.
ARGUS_KEY=replace-me
