# Prometheus, the upstream that feeds the two wall boards.
#
# Read ONLY server-side, by src/server/api.ts. It is not prefixed VITE_, and
# that is deliberate: Vite inlines VITE_-prefixed variables into the client
# bundle, and the browser must never learn where Prometheus is, let alone
# query it.
#
# Base URL of Prometheus's HTTP API, with no key: the proxy appends
# /api/v1/query. In the cluster this is the in-cluster service address.
PROMETHEUS_URL=http://localhost:9090
